# Copy to .env.local and fill in. Never commit real values.

# "fixture" runs the UI on example data. "github" arrives in Milestone 1.
DATA_SOURCE=fixture

# GitHub OAuth App (Milestone 1)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Session signing: generate with `openssl rand -base64 32`
AUTH_SECRET=

# The only GitHub login allowed to sign in
ALLOWED_GITHUB_LOGIN=

# Turso database (Milestone 1)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Protects the daily snapshot route (Milestone 2)
CRON_SECRET=
# GitHub personal access token the daily job reads repos with (no signed-in owner at 6am).
# Needs the same read access as sign-in: classic token with `repo`, or fine-grained read-only.
GITHUB_CRON_TOKEN=

# Resend email for the daily reminder (Milestone 3). Create a key at https://resend.com/api-keys.
# While Resend's test sender (onboarding@resend.dev) is used, mail can only go to the email address
# of your Resend account. To send from your own address, verify a domain in Resend first.
RESEND_API_KEY=
# Where the reminder goes
REMINDER_EMAIL_TO=
# Optional: the From line, for example "Focus Trail <reminders@your-domain.com>"
REMINDER_EMAIL_FROM=
# Optional: your first name for the greeting
REMINDER_NAME=

# Vercel deploy status (optional, Milestone 4). Create a token at https://vercel.com/account/tokens.
# Without it the dashboard just shows no deploy status.
VERCEL_TOKEN=
# Only when the projects belong to a team
VERCEL_TEAM_ID=

# Optional: your IANA timezone, for example America/Toronto. The dashboard follows the timezone your
# browser reports; this only sets "today" for the daily jobs, which have no browser. Defaults to UTC.
APP_TIMEZONE=
